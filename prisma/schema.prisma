// Prisma 6.x — `url` belongs in the schema (not Prisma 7 prisma.config.ts style)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model WordEntry {
  id              String   @id @default(cuid())
  word            String
  definition      String
  partOfSpeech    String
  phonetic        String?
  audioUrl        String?
  exampleSentence String?
  createdAt       DateTime @default(now())
}
